# Copy to compose/.env (gitignored) before `docker compose up`.
# Any long random string. Clients send it as `Authorization: Bearer <key>` or `x-api-key: <key>`; /health stays open.
API_KEY=change-me-to-a-long-random-string

# Optional overrides (defaults shown):
# MODEL_DIR=/mnt/models/dsv41-flash-exl3          # where the checkpoint (and its recipe/ folder) was downloaded
# CACHE_DIR=${HOME}/.cache/dsv41-flash-exl3        # JIT kernel caches + LMCache disk tier (put it on a fast NVMe)
# GPU_A=0                                          # host indices of the two RTX PRO 6000 cards (nvidia-smi -L)
# GPU_B=1
